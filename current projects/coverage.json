  "ambiguous_symbol_rules": {
    "ARE": {
      "require_any": [
        "alexandria real estate",
        "alexandria real estate equities",
        "life science reit are"
      ],
      "reason": "Ticker 'ARE' is common English word. Require company name or 'life science' + REIT context",
